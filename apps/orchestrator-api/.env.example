# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database (Postgres)
DATABASE_URL=postgresql://orchestrator:change-me@localhost:5432/orchestrator

# Redis (filas BullMQ)
REDIS_URL=redis://localhost:6379

# LiteLLM Gateway
LITELLM_BASE_URL=http://llm.agent.local:4000
# Chave virtual do LiteLLM para o orquestrador, não o master key.
LITELLM_API_KEY=sk-change-me

# Card providers
CARD_PRIMARY_PROVIDER=plane
CARD_EXTRA_PROVIDERS=linear

# Plane (provider principal)
PLANE_BASE_URL=http://10.10.0.14:8080
PLANE_API_KEY=change-me
PLANE_WORKSPACE_SLUG=attodev
PLANE_PROJECT_ID=change-me
PLANE_WEBHOOK_SECRET=change-me
PLANE_AI_READY_LABEL_ID=change-me
PLANE_APPROVED_LABEL_ID=change-me
PLANE_AUTO_MERGE_LABEL_ID=change-me
PLANE_SCHEDULED_LABEL_ID=change-me
PLANE_DONE_STATE_ID=change-me

# Legacy optional provider: Linear
LINEAR_API_KEY=lin_api_change-me
LINEAR_WEBHOOK_SECRET=change-me

# GitHub (token com escopo mínimo: repo, pull_request)
GITHUB_TOKEN=ghp_change-me

# Repositórios gerados (landing pages/sites finais)
GENERATED_REPOS_OWNER=attodevlabs
GENERATED_REPOS_TOKEN=
GENERATED_REPOS_TEMPLATE=attodevlabs/landing-page-template-astro-react
GENERATED_REPOS_ALLOW_CREATE=false

# Cloudflare Workers deploy automático pós auto-merge de landing gerada
CLOUDFLARE_DEPLOY_GENERATED_LANDINGS=false
CLOUDFLARE_DEPLOY_COMMANDS='pnpm install --frozen-lockfile\npnpm deploy:cloudflare'

# Runners
RUNNER_BASE_URL=http://10.10.0.12:8080
# Worker Manager (MAC-39): runners adicionais p/ failover, separados por vírgula.
# Ausente → usa só RUNNER_BASE_URL.
RUNNER_BASE_URLS=

# Scheduler (MAC-38)
LINEAR_TEAM_ID=043897b1-4201-46d2-bf1a-ec0af0cda65f
SCHEDULER_TZ=UTC
PLANE_SCHEDULED_LABEL_ID=
LINEAR_SCHEDULED_LABEL_ID=

# Auto-merge (MAC-67): label de opt-in + estado Done do time
PLANE_AUTO_MERGE_LABEL_ID=
LINEAR_AUTO_MERGE_LABEL_ID=
PLANE_DONE_STATE_ID=change-me
LINEAR_DONE_STATE_ID=79e3b949-6f1f-469d-902d-71d135d18cae

# Agent Registry (MAC-42): key do agente default
AGENT_KEY=coder-agent

# Multi-Agent Execution (MAC-47): runs em paralelo
AGENT_MAX_CONCURRENCY=3
