# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database (Postgres)
DATABASE_URL=postgresql://orchestrator:change-me@localhost:5432/orchestrator

# Redis (filas BullMQ)
REDIS_URL=redis://localhost:6379

# LiteLLM Gateway
LITELLM_BASE_URL=http://llm.agent.local:4000
# Chave virtual do LiteLLM para o orquestrador, não o master key.
LITELLM_API_KEY=sk-change-me

# Linear
LINEAR_API_KEY=lin_api_change-me
LINEAR_WEBHOOK_SECRET=change-me

# GitHub (token com escopo mínimo: repo, pull_request)
GITHUB_TOKEN=ghp_change-me

# Runners
RUNNER_BASE_URL=http://10.10.0.12:8080
# Worker Manager (MAC-39): runners adicionais p/ failover, separados por vírgula.
# Ausente → usa só RUNNER_BASE_URL.
RUNNER_BASE_URLS=

# Scheduler (MAC-38)
LINEAR_TEAM_ID=043897b1-4201-46d2-bf1a-ec0af0cda65f
SCHEDULER_TZ=UTC
LINEAR_SCHEDULED_LABEL_ID=

# Agent Registry (MAC-42): key do agente default
AGENT_KEY=coder-agent
