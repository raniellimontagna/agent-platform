# Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Diretórios de trabalho do runner (montados da VM)
RUNNER_WORKDIR=/srv/agent-runners/worktrees
RUNNER_ARTIFACTS_DIR=/srv/agent-runners/artifacts
HIGGSFIELD_HOME=/srv/agent-runners/higgsfield
HIGGSFIELD_PREFERRED_IMAGE_MODELS=seedream_v5_lite,flux_2,seedream_v4_5,nano_banana,kling_omni_image,gpt_image_2
HIGGSFIELD_GENERATE_TIMEOUT=10m
HIGGSFIELD_POLL_INTERVAL=5s

# LiteLLM Gateway
LITELLM_BASE_URL=http://llm.agent.local:4000
# Chave virtual do LiteLLM para o runner, não o master key.
LITELLM_API_KEY=sk-change-me

# Orquestrador (callbacks de resultado)
ORCHESTRATOR_BASE_URL=http://api.agent.local:3000

# Token compartilhado para autenticar chamadas do orquestrador
RUNNER_AUTH_TOKEN=change-me

# Firecrawl (MAC-94): usado pelo data-collector-agent para research packs.
# Opcional no boot; sem chave, jobs de coleta falham de forma explícita.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_MS=60000

# Cloudflare Workers deploy de landing pages geradas
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Sandbox Executor (MAC-28)
# development/test: process; produção: docker
AGENT_SANDBOX_BACKEND=process
AGENT_SANDBOX_IMAGE=agent-platform/worker-code:latest
AGENT_SANDBOX_NETWORK=bridge
AGENT_SANDBOX_CPUS=2
AGENT_SANDBOX_MEMORY=2g
AGENT_SANDBOX_PIDS_LIMIT=512
AGENT_COMMAND_ALLOWLIST=pnpm,node,npm,npx,git,higgsfield,higgs
