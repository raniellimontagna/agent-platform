[Unit]
Description=Agent Platform OmniRoute TCP proxy
After=network-online.target
Wants=network-online.target

[Service]
# PROXMOX_LAN_IP e AGENT_GATEWAY_IP vêm de /etc/default/agent-platform-proxy.
EnvironmentFile=/etc/default/agent-platform-proxy
ExecStart=/usr/bin/socat TCP-LISTEN:20128,bind=${PROXMOX_LAN_IP},fork,reuseaddr TCP:${AGENT_GATEWAY_IP}:20128
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
