[Unit]
Description=Agent Platform registry LAN proxy
Requires=agent-registry-proxy.socket
After=network-online.target

[Service]
# AGENT_GATEWAY_IP vem de /etc/default/agent-platform-proxy.
EnvironmentFile=/etc/default/agent-platform-proxy
ExecStart=/lib/systemd/systemd-socket-proxyd ${AGENT_GATEWAY_IP}:80
NoNewPrivileges=true
PrivateTmp=true
