# Postgres do orquestrador
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orchestrator

# LiteLLM (agent-gateway)
LITELLM_BASE_URL=http://llm.agent.local:4000
# Chave virtual do LiteLLM para o orquestrador, não o master key.
LITELLM_API_KEY=sk-change-me

# Card providers
CARD_PRIMARY_PROVIDER=plane
CARD_EXTRA_PROVIDERS=linear

# Plane (provider principal)
PLANE_BASE_URL=http://10.10.0.14:8080
PLANE_API_KEY=change-me
PLANE_WORKSPACE_SLUG=attodev
PLANE_PROJECT_ID=change-me
PLANE_WEBHOOK_SECRET=change-me
PLANE_AI_READY_LABEL_ID=change-me
PLANE_APPROVED_LABEL_ID=change-me
PLANE_AUTO_MERGE_LABEL_ID=change-me
PLANE_SCHEDULED_LABEL_ID=change-me
PLANE_DONE_STATE_ID=change-me

# Legacy optional provider: Linear
LINEAR_WEBHOOK_SECRET=change-me
LINEAR_API_KEY=lin_api_change-me

# GitHub (token com escopo mínimo: repo, pull_request)
GITHUB_TOKEN=ghp_change-me

# Runners
RUNNER_BASE_URL=http://10.10.0.12:8080
# Deve bater com o RUNNER_AUTH_TOKEN do runner (worker-code).
RUNNER_AUTH_TOKEN=change-me

# Repo alvo que o agente vai modificar (default no código: agent-platform).
REPO_URL=https://github.com/raniellimontagna/agent-platform.git

# Loop de revisão pelo critic: quantas vezes o coder pode tentar corrigir ressalvas/reprovações.
AGENT_MAX_REVIEW_ROUNDS=3
