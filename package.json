{
  "name": "agent-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "eval": "corepack pnpm --filter @agent-platform/worker-code eval",
    "eval:regression": "corepack pnpm --filter @agent-platform/worker-code eval -- --fail-on-regression",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "skills:sync": "node scripts/sync-agent-skills.mjs",
    "skills:check": "node scripts/sync-agent-skills.mjs --check",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "verify": "corepack pnpm skills:check && corepack pnpm lint && corepack pnpm verify:loop && corepack pnpm eval:regression",
    "verify:loop": "corepack pnpm -r build && corepack pnpm test && corepack pnpm eval"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0"
  }
}
